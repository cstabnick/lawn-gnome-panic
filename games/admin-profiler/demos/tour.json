{
  "title": "Hitch Profiler: brush-zoom the time series, then step through a session's hitches",
  "url": "http://localhost:5205/",
  "setup": { "demo": true },
  "size": [1100, 680],
  "fps": 12,
  "warmup": 2.5,
  "duration": 9,
