    { "t": 3.4, "press": "ArrowDown" },
    { "t": 3.5, "press": "ArrowDown" },
    { "t": 3.6, "press": "ArrowDown" },
    { "t": 3.7, "press": "ArrowDown" },
    { "t": 3.8, "press": "ArrowDown" },
    { "t": 3.9, "press": "ArrowDown" },
    { "t": 4.6, "press": "KeyJ" },
    { "t": 5.3, "press": "KeyJ" },
    { "t": 6.0, "press": "KeyJ" },
    { "t": 6.7, "press": "KeyK" },
    { "t": 7.4, "press": "KeyJ" }
  ]
}
