    "@lawn/level": "*",
    "@lawn/mp": "*",
    "@lawn/music": "*",
    "@lawn/oakcount": "*",
    "@lawn/platform": "*",
    "@lawn/portal": "*",
    "@lawn/prefabs": "*",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
