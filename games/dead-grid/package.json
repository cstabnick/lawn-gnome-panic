{
  "name": "dead-grid",
  "private": true,
  "type": "module",
  "lawn": {
    "hidden": true
  },
  "description": "WASM-core post-apocalyptic society simulator: thousands of zombies and survivors on a 512x512 DayZ-inspired grid with live tuning and overlays.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:wasm": "node scripts/build-wasm.mjs"
  },
  "devDependencies": {
    "assemblyscript": "0.28.20",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
