      { "id": "vk-npc-3", "name": "Photo Tourist Pip", "kind": "gnome", "hatColor": "#00e5ff", "shirtColor": "#4f3266", "x": -16, "y": 0, "z": 33, "yaw": 0.3, "line": "Quick! Stand behind the skater cutout—my clay glaze looks fabulous in neon pink!" },
      { "id": "vk-npc-4", "name": "Keynote Fan", "kind": "woken", "prefab": "gsr-metronome", "x": 8, "y": 3.5, "z": -10, "yaw": -0.5, "line": "Tick-tock! 162 BPM Dorian—Maestro hates it when someone grinds the balcony!" },
      { "id": "vk-npc-5", "name": "Crate-Digger Fern", "kind": "gnome", "hatColor": "#ffd740", "shirtColor": "#342354", "x": -34, "y": 5.2, "z": -22, "yaw": 0.9, "line": "The Vinyl Rotunda presses every bootleg record that drifts up from Turfton." },
      { "id": "vk-npc-6", "name": "Telescope Sightseer", "kind": "gnome", "hatColor": "#ff9100", "shirtColor": "#2f224f", "x": 36, "y": 4.8, "z": -24, "yaw": -0.8, "line": "From the Amphitheater roof you can almost spot Aether Board's snow peaks!" },
      { "id": "vk-npc-7", "name": "Rim Skater Jax", "kind": "gnome", "hatColor": "#00e5ff", "shirtColor": "#ff4ecd", "x": -54, "y": 0, "z": 4, "yaw": 1.57, "line": "The outer rim rails wrap the whole island—hit the kicker ramps for huge air!" },
      { "id": "vk-npc-8", "name": "Gondola Porter", "kind": "gnome", "hatColor": "#ffd740", "shirtColor": "#3d2f5e", "x": -48, "y": 0, "z": 24, "yaw": 1.2, "line": "Next pink gondola to Turfton leaves at bar 32—or just grind the sky-rails!" },
