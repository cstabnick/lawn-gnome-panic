{
  "name": "gnome-theft-auto",
  "private": true,
  "type": "module",
  "description": "Open-town gnome crime sandbox: steal mowers, soak gnomes with water guns, and lift the Whirligig flying mower from Fort Sandpit.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:wasm": "node scripts/build-wasm.mjs",
    "bench:wasm": "node scripts/bench-wasm.mjs",
    "mp-audit": "vitest run --config vitest.slow.config.ts",
    "cutscene-report": "vitest run src/cutscene/pacing.test.ts",
    "quest-sim": "node ../../tools/quest-sim.mjs --headless",
    "quest-fuzz": "node ../../tools/quest-fuzz.mjs",
    "quest-sim:e2e": "node ../../tools/quest-sim.mjs",
    "quest-sim:suites": "vitest run --config vitest.sim.config.ts"
  },
  "dependencies": {
    "@lawn/achievements": "*",
    "@lawn/cloudsave": "*",
    "@lawn/depth": "*",
    "@lawn/emotes": "*",
    "@lawn/gamepad": "*",
    "@lawn/glaze": "*",
    "@lawn/gnome": "*",
    "@lawn/golf": "*",
    "@lawn/level": "*",
    "@lawn/mp": "*",
    "@lawn/music": "*",
    "@lawn/mutter": "*",
    "@lawn/oakcount": "*",
    "@lawn/party": "*",
    "@lawn/portal": "*",
    "@lawn/prefabs": "*",
    "@lawn/profiler": "*",
    "@lawn/vehicle": "*",
    "sam-js": "^0.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "assemblyscript": "0.28.20",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
