{
  "name": "gnomeokemon",
  "private": true,
  "description": "Gnomokemon Snap: full-screen photo safari with a 3D Field Lab for menus, a Gnomokedex model viewer and a photo gallery. Models are @lawn/prefabs definitions themed off Gnomomia lore.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lawn/cloudsave": "*",
    "@lawn/platform": "*",
    "@arcade/volume": "*",
    "@lawn/gnome": "*",
    "@lawn/level": "*",
    "@lawn/music": "*",
    "@lawn/mutter": "*",
    "@lawn/prefabs": "*",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
