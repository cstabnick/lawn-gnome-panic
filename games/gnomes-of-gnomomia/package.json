{
  "name": "gnomes-of-gnomomia",
  "private": true,
  "description": "An old-school click-to-move 3D gnome RPG: quests, loot, d20 combat and skills that grow by use.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/check-bake.mjs && vite build",
    "bake-walk": "node scripts/bake-walk.mjs",
    "check-bake": "node scripts/check-bake.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "bench:wasm": "node scripts/bench-wasm.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint:content": "node scripts/lint-content.mjs",
    "test": "vitest run",
    "sim": "node scripts/sim-balance.mjs",
    "sim:demo": "node scripts/sim-demo.mjs",
    "sim:town": "node scripts/sim-town.mjs",
    "sim:economy": "node scripts/sim-economy.mjs",
    "sim:raid": "node scripts/sim-raid.mjs"
  },
  "dependencies": {
    "@arcade/volume": "*",
    "@lawn/achievements": "*",
    "@lawn/cloudsave": "*",
    "@lawn/depth": "*",
    "@lawn/emotes": "*",
    "@lawn/gnome": "*",
    "@lawn/level": "*",
    "@lawn/mp": "*",
    "@lawn/music": "*",
    "@lawn/platform": "*",
    "@lawn/prefabs": "*",
    "@lawn/profiler": "*",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "assemblyscript": "^0.28.20",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
