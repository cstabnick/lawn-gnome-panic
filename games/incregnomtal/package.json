{
  "name": "incregnomtal",
  "private": true,
  "description": "Grow a lawn on a bare patch of the Yard: hire gnomes, solve each problem that your last fix caused, befriend Biscuit, and tame Old Saturday.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "node --experimental-strip-types src/sim/run-sim.ts"
  },
  "dependencies": {
    "@arcade/volume": "*",
    "@lawn/achievements": "*",
    "@lawn/gnome": "*",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
