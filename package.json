{
  "name": "gaming-testbed",
  "private": true,
  "workspaces": [
    "games/*",
    "packages/*",
    "tools/prefab-editor",
    "tools/level-editor"
  ],
  "scripts": {
    "new": "node tools/new-game.mjs",
    "new-mini": "node tools/new-minigame.mjs",
    "site": "node tools/build-site.mjs",
    "demo": "node tools/record-demo.mjs",
    "lore": "node tools/lore.mjs",
    "prefab-editor": "npm run dev -w tools/prefab-editor",
    "level-editor": "npm run dev -w tools/level-editor",
    "zfight": "node tools/zfight.mjs"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "gifenc": "1.0.3",
    "pngjs": "7.0.0",
    "puppeteer-core": "24.10.0"
  }
}
