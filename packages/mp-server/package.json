{
  "name": "@lawn/mp-server",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit -p . && esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server.mjs --external:ws --external:obscenity --external:@opentelemetry/*",
    "start": "node dist/server.mjs",
    "dev": "npm run build && node dist/server.mjs",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-logs": "3.0.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "obscenity": "0.4.6",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@grpc/grpc-js": "1.14.7",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
