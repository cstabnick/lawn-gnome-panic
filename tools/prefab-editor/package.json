{
  "name": "prefab-editor",
  "private": true,
  "description": "Local tool: edit @lawn/prefabs parts, grips and worn offsets on a live gnome, and save them back to the catalog source.",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lawn/achievements": "*",
    "@lawn/gnome": "*",
    "@lawn/prefabs": "*",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
